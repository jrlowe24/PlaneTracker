# Copy to client/.env (gitignored) and fill in. Never commit real keys.

# Google Maps Platform API key restricted to the Map Tiles API and to your
# HTTP referrers. See README "Google Cloud setup".
VITE_GOOGLE_MAPS_API_KEY=

# Set to 1 to replace Google Photorealistic 3D Tiles with a plain WGS84
# ellipsoid. Use this for non-visual work so you don't create billable
# root-tileset sessions on every reload.
VITE_DISABLE_TILES=0
