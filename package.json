{
  "name": "window-seat",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @windowseat/server --filter @windowseat/client dev",
    "dev:replay": "REPLAY=1 pnpm dev",
    "dev:synth": "SYNTH=${SYNTH:-12000} pnpm dev",
    "dev:client": "pnpm --filter @windowseat/client dev",
    "dev:server": "pnpm --filter @windowseat/server dev",
    "build": "pnpm --filter @windowseat/client build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint client server shared eslint.config.js",
    "test": "pnpm -r test",
    "record": "pnpm --filter @windowseat/server record"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "16.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
